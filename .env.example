# ==============================================================================
# MANAM.in Environment Configuration
# ==============================================================================
# Configure separate values in Vercel for Production (manam.in -> prod Firebase)
# and Preview (staging domain -> staging Firebase).
# NEVER prefix server-only secrets with VITE_.

# ------------------------------------------------------------------------------
# CLIENT-SIDE PUBLIC VARIABLES (Exposed to browser via Vite; safe to publish)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
# Optional: specify named Firestore database ID (leave "(default)" for standard Vercel Firebase projects)
VITE_FIREBASE_DATABASE_ID="(default)"
# Optional: Firebase App Check reCAPTCHA v3 public site key
VITE_RECAPTCHA_SITE_KEY=""

# ------------------------------------------------------------------------------
# SERVER-ONLY VARIABLES (Used ONLY by /api/* Vercel serverless functions)
# NEVER expose these in client bundles or prefix with VITE_.
# ------------------------------------------------------------------------------
# Single-line JSON string of your Firebase service account private key
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}'
# Verified Google email for the sole platform super admin
SUPER_ADMIN_EMAIL="jbackup025@gmail.com"
# Strong random bearer secret used by Vercel Cron to authorize GET /api/cron/daily
CRON_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
# Optional: named Firestore database ID for firebase-admin (defaults to "(default)" if unset)
FIREBASE_DATABASE_ID="(default)"
